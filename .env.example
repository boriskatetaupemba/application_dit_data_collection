# Les valeurs réelles doivent rester dans .env (ignoré par Git) ou dans
# .streamlit/secrets.toml lors d'un lancement Streamlit.
DATABASE_URL=sqlite:///data/data_collection.db
GOOGLE_FORM_URL=
